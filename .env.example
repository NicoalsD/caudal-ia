# Nivel de detalle de los registros de la aplicación.
LOG_LEVEL=INFO

# Habilita la documentación interactiva de Swagger.
API_DOCS_ENABLED=true

# Modelo Chronos activo y dispositivo de inferencia.
CHRONOS_MODEL_ID=autogluon/chronos-2-small
CHRONOS_DEVICE=cpu

# Cantidad mínima de lecturas para generar un pronóstico.
FORECAST_MIN_POINTS=7

# Cantidad máxima de puntos permitidos en una serie.
MAX_SERIES_POINTS=2000

# Longitud máxima permitida para el pronóstico.
MAX_PREDICTION_LENGTH=30

# Tamaño máximo permitido para el cuerpo de una petición, en bytes.
MAX_BODY_BYTES=262144

# Token de servicio que el backend envía en Authorization: Bearer.
# Mínimo 32 bytes aleatorios: python -c "import secrets; print(secrets.token_urlsafe(32))"
IA_SERVICE_TOKEN=<token-de-servicio>
