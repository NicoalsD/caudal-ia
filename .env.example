# Nivel de detalle de los registros de la aplicación.
LOG_LEVEL=INFO

# Habilita la documentación interactiva de Swagger.
API_DOCS_ENABLED=true

# Modelo Chronos activo y dispositivo de inferencia.
CHRONOS_MODEL_ID=autogluon/chronos-2-small
CHRONOS_DEVICE=cpu

# Zona horaria del acueducto: los días de la serie empiezan a medianoche en esta zona.
SERIES_TIMEZONE=America/Bogota

# Cómo se resume cada día con varias lecturas: last (la última) o mean (el promedio).
RESAMPLE_AGGREGATION=last

# Cantidad mínima de días con lectura (después de re-muestrear) para pronosticar.
FORECAST_MIN_POINTS=7

# Caché en memoria de pronósticos idénticos: cuántos guardar (0 la apaga) y por
# cuántos segundos. La clave es un hash SHA-256 de la petición; la serie no se guarda.
FORECAST_CACHE_SIZE=64
FORECAST_CACHE_TTL_SECONDS=300

# Evaluación offline (backtest): pronósticos evaluados mínimos por horizonte y
# banda de cobertura calibrada (fracción de objetivos entre p10 y p90).
BACKTEST_MIN_EVALUATIONS=30
BACKTEST_COVERAGE_MIN=0.7
BACKTEST_COVERAGE_MAX=0.9

# Cantidad máxima de puntos permitidos en una serie.
MAX_SERIES_POINTS=2000

# Longitud máxima permitida para el pronóstico.
MAX_PREDICTION_LENGTH=30

# Tamaño máximo permitido para el cuerpo de una petición, en bytes.
MAX_BODY_BYTES=262144

# Token de servicio que el backend envía en Authorization: Bearer.
# Mínimo 32 bytes aleatorios: python -c "import secrets; print(secrets.token_urlsafe(32))"
IA_SERVICE_TOKEN=<token-de-servicio>

# Token anterior, solo durante una rotación (opcional). Se retira al terminarla.
IA_SERVICE_TOKEN_PREVIOUS=

# Asistente (insights). Cualquier servidor compatible con OpenAI /chat/completions.
# Sin LLM_API_KEY el servicio siempre responde con las reglas de respaldo (source: RULES).
# Por defecto Nemotron de NVIDIA, gratis en OpenRouter; la clave se crea en openrouter.ai y NUNCA se versiona.
LLM_BASE_URL=https://openrouter.ai/api/v1/
LLM_MODEL=nvidia/nemotron-3.5-super-vl:free
LLM_API_KEY=
# Tiempo máximo por intento, en segundos, y reintentos tras timeout, error de red o 5xx.
# Un 429 no se reintenta: se usa el respaldo de inmediato.
LLM_TIMEOUT_S=15
LLM_MAX_RETRIES=1
# Tope de tokens de salida, de bytes aceptados en la respuesta y temperatura.
LLM_MAX_OUTPUT_TOKENS=2048
LLM_MAX_RESPONSE_BYTES=65536
LLM_TEMPERATURE=0.2
# Margen (puntos porcentuales sobre el piso de reserva) bajo el cual las reglas
# de respaldo prefieren esperar en vez de abrir una llave.
ASSISTANT_OPEN_MARGIN_PCT=10

# Límite de memoria pico, en MB, para scripts/measure_memory.py (no lo lee el servicio).
# Por defecto 2048 MB, orientativo: verifica el plan de hosting antes de fijarlo.
MEMORY_LIMIT_MB=2048
